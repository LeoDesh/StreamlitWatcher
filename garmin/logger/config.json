{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "simple": {
            "format": "%(asctime)s || %(levelname)s: %(message)s",
            "datefmt": "%d.%m.%Y %H:%M:%S"
        },
        "verbose": {
            "format": "[%(asctime)s] %(levelname)s | [%(filename)s:%(lineno)s] %(message)s | %(funcName)s | %(module)s",
            "datefmt": "%d.%m.%Y %H:%M:%S"
        }
    },
    "handlers": {
        "rotation_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "INFO",
            "formatter": "simple",
            "filename": "garmin/logger/logs/messages.log",
            "maxBytes": 10000,
            "backupCount": 3
        }
    },
    "loggers": {
        "app": {
            "handlers": ["rotation_file"],
            "level": "INFO"
        }
    }
}